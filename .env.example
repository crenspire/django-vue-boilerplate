# Copy to .env and load it, e.g. `uv run --env-file .env python starterkit/manage.py runserver`.
# Every variable is optional for local development.

# --- Core ---------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Comma-separated. Defaults to localhost,127.0.0.1 in debug and nothing otherwise.
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins, e.g. https://admin.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SQLITE_PATH=
DJANGO_STATIC_ROOT=

# --- Vite ---------------------------------------------------------------
# Defaults to DJANGO_DEBUG. Set false to serve the built bundle locally.
DJANGO_VITE_DEV_MODE=
# Must match VITE_PORT used when running `npm run dev`.
DJANGO_VITE_DEV_SERVER_PORT=5173

# --- HTTPS hardening (only applied when DJANGO_DEBUG=false) -------------
DJANGO_SECURE_SSL_REDIRECT=true
# Opt in deliberately: HSTS is hard to undo once browsers cache it.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
